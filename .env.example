# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# ---- Oracle (backend) ----
# Single-user auth. Generate the hash with the project helper (Phase 0) — do NOT
# store the plaintext password here.
APP_USERNAME=changeme
APP_PASSWORD_HASH=            # bcrypt hash of your password
JWT_SECRET=                   # long random string, e.g. `openssl rand -hex 32`
JWT_EXPIRE_MINUTES=1440

# Database (matches infra/docker-compose.yml service name in dev)
DATABASE_URL=postgresql+psycopg://kleio:kleio@localhost:5432/kleio
POSTGRES_USER=kleio
POSTGRES_PASSWORD=kleio
POSTGRES_DB=kleio

# ---- AI (added at the summarization / Q&A phases) ----
GEMINI_API_KEY=              # Google AI Studio API key; without it, summarize/ask return 503
GEMINI_MODEL=gemini-2.5-flash
# Embedding model for RAG Q&A over notes. The vector width is fixed in code/migration
# (768 dims) — change the model here, but a different dimension needs a new migration.
GEMINI_EMBED_MODEL=gemini-embedding-001

# ---- 5etools reference import (Phase 13) ----
# Kleio ships no game data (it's WotC-copyrighted, not SRD/OGL), so reference import is off
# until a dataset exists. Two ways to get one, and you only need one of them:
#
#   1. Press "Download reference data" on the campaigns page (or run
#      `python scripts/fetch_fivetools.py` from oracle/). It saves into FIVETOOLS_DOWNLOAD_DIR.
#   2. Point FIVETOOLS_DATA_DIR at your own copy — either its root or its `data/` directory.
#      Setting this WINS over a download, and disables the download button (the oracle would
#      never read what it fetched). In Docker, mount your copy read-only and point this at the
#      container path — see infra/docker-compose.yml.
FIVETOOLS_DATA_DIR=

# Where the download lands. Relative paths resolve against oracle/ (and are gitignored).
FIVETOOLS_DOWNLOAD_DIR=var/fivetools
# Where it downloads from. 5etools has no API — these are its static JSON paths, so this can
# break when the site reorganizes; repoint it at a mirror if that happens.
FIVETOOLS_SOURCE_URL=https://5e.tools/data

# ---- Herald (frontend) ----
# API base path; nginx proxies /api in prod so this is usually just "/api".
API_BASE_URL=/api
